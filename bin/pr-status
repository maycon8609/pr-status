#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks portably so this script works when invoked via ~/.local/bin/pr-status
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

exec python3 "$DIR/../skills/pr-status/scripts/audit_prs.py" "$@"
